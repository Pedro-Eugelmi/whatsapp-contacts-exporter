{
  "manifest_version": 3,
  "name": "Exportador de Contatos e Etiquetas (WhatsApp Web)",
  "version": "0.1.2",
  "description": "Exporta contatos e etiquetas do WhatsApp Web para CSV. 100% local, sem servidor.",
  "permissions": ["activeTab"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "action": {
    "default_title": "Exportar contatos e etiquetas",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
